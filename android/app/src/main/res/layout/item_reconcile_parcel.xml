<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_parcel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: Reference, Copy, Attempts Badge, Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_parcel_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="LG095266299MA" />

            <ImageView
                android:id="@+id/btn_copy_ref"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copier le code"
                android:padding="3dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_muted" />

            <!-- Attempts Badge -->
            <TextView
                android:id="@+id/badge_attempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_amount"
                android:backgroundTint="#EA580C"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2 tentatives"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status Tag (Non livré vs Scanné) -->
            <TextView
                android:id="@+id/text_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_amount"
                android:backgroundTint="@color/status_undelivered_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/status_undelivered_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="✖ Non livré" />

        </LinearLayout>

        <!-- Failure Reason Banner (if non-delivered) -->
        <LinearLayout
            android:id="@+id/layout_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FEF2F2"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motif : "
                android:textColor="#991B1B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_failure_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B91C1C"
                android:textSize="11sp"
                tools:text="Client injoignable après appel" />
        </LinearLayout>

        <!-- Middle Row: Recipient & COD Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_recipient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Abdelkader El Aidi" />

                <TextView
                    android:id="@+id/text_recipient_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    tools:text="Hay Farah, Mohammedia" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_cod_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/settlement_green"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="150,00 MAD" />
        </LinearLayout>

        <!-- Action Row: Scan / Unscan / Open Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_open_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="Fiche colis ›"
                android:textColor="@color/chrono_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Checkbox for Delivered Parcels with Price -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_delivered"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Coché pour règlement"
                android:textColor="@color/settlement_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:buttonTint="@color/settlement_green"
                tools:visibility="visible" />

            <!-- Manual Mark as Scanned / Inscan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_scan"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:text="📥 Inscan"
                android:textColor="@color/chrono_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_in_transit"
                app:iconSize="14dp"
                app:iconTint="@color/chrono_primary" />

            <!-- Unscan Button (Visible when already scanned) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_unscan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="Annuler"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
